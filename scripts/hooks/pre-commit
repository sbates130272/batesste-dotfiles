#!/usr/bin/env bash
# Prevent accidentally committing secret values into the settings template.
# install.sh injects API keys at generation time — they must never be in the template.
set -euo pipefail

TEMPLATE="templates/claude-settings-local.json"

if git diff --cached --name-only | grep -qF "$TEMPLATE"; then
    if git show ":$TEMPLATE" | grep -qE '"ANTHROPIC_API_KEY"\s*:\s*"[^$]|"ANTHROPIC_CUSTOM_HEADERS"\s*:\s*"[^$]'; then
        echo "ERROR: $TEMPLATE is staged and appears to contain a secret value." >&2
        echo "       install.sh injects API keys at runtime — do not commit them into the template." >&2
        echo "       Run: git restore --staged $TEMPLATE" >&2
        exit 1
    fi
fi
