#!/usr/bin/env bash
# Scan staged files for patterns that look like secrets before committing.
# git-crypt encrypted files are binary blobs — they are skipped automatically
# since grep will not match text patterns in them.
set -euo pipefail

RED='\033[0;31m'
YELLOW='\033[0;33m'
NC='\033[0m'

# Patterns that strongly indicate a secret value (not just a key name).
# Each entry is a label and a regex applied to staged file content.
declare -A PATTERNS=(
    ["Anthropic API key"]='sk-ant-[a-zA-Z0-9_-]{20,}'
    ["HuggingFace token"]='hf_[a-zA-Z0-9]{20,}'
    ["Docker auth (base64)"]='\"auth\":[[:space:]]*\"[A-Za-z0-9+/]{20,}={0,2}\"'
    ["GitHub token"]='gh[pousr]_[A-Za-z0-9]{36,}'
    ["Generic hex secret (32+ chars)"]='[0-9a-f]{32,}'
    ["Generic high-entropy string"]='[A-Za-z0-9+/]{40,}={0,2}'
)

# Staged files that are text (not binary, not git-crypt encrypted).
mapfile -t staged < <(git diff --cached --name-only --diff-filter=ACM)

# Files declared as git-crypt encrypted in .gitattributes — safe to skip
# whether the repo is locked (binary blob) or unlocked (plaintext).
mapfile -t git_crypt_files < <(git check-attr filter -- "${staged[@]}" 2>/dev/null | awk -F': ' '$3 == "git-crypt" {print $1}')
declare -A git_crypt_set
for f in "${git_crypt_files[@]}"; do git_crypt_set["$f"]=1; done

found=0
# Paths that are known-safe and should not be scanned for secrets.
# Patch files (.patch, .diff) in a patches/ directory intentionally contain
# git SHAs (40-char hex) and long file paths that trigger high-entropy patterns.
# These are structural metadata, not credentials.
declare -a SECRET_SCAN_ALLOWLIST=(
    "patches/"
)

for file in "${staged[@]}"; do
    # Skip if file is not in the working tree (e.g. deleted)
    [[ -f "$file" ]] || continue

    # Skip explicitly allowed paths (patch files with git SHAs, long kernel paths)
    _skip=0
    for _allowed in "${SECRET_SCAN_ALLOWLIST[@]}"; do
        [[ "$file" == "${_allowed}"* ]] && _skip=1 && break
    done
    [[ "$_skip" -eq 1 ]] && continue

    # Skip files managed by git-crypt (encrypted at rest, safe regardless of lock state)
    [[ -n "${git_crypt_set[$file]:-}" ]] && continue

    # Skip binary / git-crypt encrypted files (they start with \x00GITCRYPT)
    if head -c 10 "$file" | grep -qP '\x00GITCRYPT'; then
        continue
    fi

    # Also skip if git detects it as binary
    if git diff --cached -- "$file" | grep -qP '^Binary'; then
        continue
    fi

    # Skip X.509 certificate files — PEM base64 always triggers high-entropy
    # patterns but is public infrastructure, not a secret.
    if [[ "$file" =~ \.(crt|pem|cer|der)$ ]]; then
        continue
    fi

    for label in "${!PATTERNS[@]}"; do
        regex="${PATTERNS[$label]}"
        # Scan only added lines (+) in the staged diff, not the full file, to
        # avoid false positives from pre-existing content like URLs.
        matches="$(git diff --cached -- "$file" | grep -P '^\+[^+]' | grep -oP "$regex" || true)"
        [[ -z "$matches" ]] && continue

        # Discard matches with no actual entropy. Git's null SHA is forty
        # zeros, which satisfies both the hex and high-entropy patterns while
        # being the one string guaranteed not to be a secret. Anything that is
        # a single character repeated is a placeholder, not a credential.
        matches="$(printf '%s\n' "$matches" | grep -vP '^(.)\1*$' || true)"
        [[ -z "$matches" ]] && continue

        # Discard matches that appear inside a URL on the same line. Secrets
        # are values, not URL path components — badge/shield URLs in Markdown
        # are the canonical false-positive source for the high-entropy pattern.
        url_lines="$(git diff --cached -- "$file" | grep -P '^\+[^+]' | grep -oP 'https?://\S+' | grep -oP "$regex" || true)"
        matches="$(comm -23 <(printf '%s\n' "$matches" | sort) <(printf '%s\n' "$url_lines" | sort) || true)"
        [[ -z "$matches" ]] && continue

        # Discard matches that are git commit SHAs used as version pins.
        # Covers: COMMIT=/COMMIT = (shell/Python), _commit: (YAML key),
        # git checkout, git rev-parse, and similar structural patterns.
        sha_lines="$(git diff --cached -- "$file" | grep -P '^\+[^+]' | grep -P '(COMMIT[[:space:]]*[=:]|_commit[[:space:]]*:|git checkout|git rev-parse|_SHA[[:space:]]*[=:]|_HASH[[:space:]]*[=:])' | grep -oP "$regex" || true)"
        matches="$(comm -23 <(printf '%s\n' "$matches" | sort) <(printf '%s\n' "$sha_lines" | sort) || true)"
        [[ -z "$matches" ]] && continue

        # Discard standalone exactly-40-char lowercase hex strings. These are
        # git SHAs appearing as bare YAML block-scalar values with no key
        # context on the same line.
        sha_bare="$(printf '%s\n' "$matches" | grep -P '^[0-9a-f]{40}$' || true)"
        matches="$(comm -23 <(printf '%s\n' "$matches" | sort) <(printf '%s\n' "$sha_bare" | sort) || true)"
        [[ -z "$matches" ]] && continue

        echo -e "${RED}[pre-commit] Possible secret detected in $file${NC}"
        echo -e "  ${YELLOW}Pattern: $label${NC}"
        found=1
    done
done

if [[ "$found" -eq 1 ]]; then
    echo ""
    echo -e "${RED}Commit blocked: potential secrets found in staged files.${NC}"
    echo "If these are intentional (e.g. a git-crypt protected file),"
    echo "ensure the file is listed in .gitattributes, then commit again."
    echo "To bypass (use with care): git commit --no-verify"
    exit 1
fi
