#!/usr/bin/env bash
# Scan staged files for patterns that look like secrets before committing.
# git-crypt encrypted files are binary blobs — they are skipped automatically
# since grep will not match text patterns in them.
set -euo pipefail

RED='\033[0;31m'
YELLOW='\033[0;33m'
NC='\033[0m'

# Patterns that strongly indicate a secret value (not just a key name).
# Generic hex is intentionally absent: 32-char hex covers UUIDs and MD5 hashes
# (not secrets), 40-char hex is a git SHA, and 48+ char hex is caught by the
# high-entropy pattern below. Specific known formats are matched precisely.
declare -A PATTERNS=(
    ["Anthropic API key"]='sk-ant-[a-zA-Z0-9_-]{20,}'
    ["HuggingFace token"]='hf_[a-zA-Z0-9]{20,}'
    ["Docker auth (base64)"]='\"auth\":[[:space:]]*\"[A-Za-z0-9+/]{40,}={0,2}\"'
    ["GitHub token"]='gh[pousr]_[A-Za-z0-9]{36,}|github_pat_[A-Za-z0-9_]{20,}'
    ["AMD API gateway key"]='Ocp-Apim-Subscription-Key:[[:space:]]*[0-9a-fA-F]{32}'
    ["Generic high-entropy string"]='[A-Za-z0-9+/]{40,}={0,2}'
)

# Staged files that are text (not binary, not git-crypt encrypted).
mapfile -t staged < <(git diff --cached --name-only --diff-filter=ACM)

# Files declared as git-crypt encrypted in .gitattributes — safe to skip
# whether the repo is locked (binary blob) or unlocked (plaintext).
mapfile -t git_crypt_files < <(
    [[ ${#staged[@]} -eq 0 ]] && exit 0
    git check-attr filter -- "${staged[@]}" 2>/dev/null \
        | awk -F': ' '$3 == "git-crypt" {print $1}'
)
declare -A git_crypt_set
for f in "${git_crypt_files[@]}"; do git_crypt_set["$f"]=1; done

found=0

# Paths where long hex strings and high-entropy patterns are structural, not secrets.
declare -a SECRET_SCAN_ALLOWLIST=(
    "patches/"
)

for file in "${staged[@]}"; do
    [[ -f "$file" ]] || continue

    _skip=0
    for _allowed in "${SECRET_SCAN_ALLOWLIST[@]}"; do
        [[ "$file" == "${_allowed}"* ]] && _skip=1 && break
    done
    [[ "$_skip" -eq 1 ]] && continue

    [[ -n "${git_crypt_set[$file]:-}" ]] && continue

    if head -c 10 "$file" | grep -qP '\x00GITCRYPT'; then
        continue
    fi

    if git diff --cached -- "$file" | grep -qP '^Binary'; then
        continue
    fi

    # X.509 files: PEM base64 always triggers high-entropy but is public infra.
    if [[ "$file" =~ \.(crt|pem|cer|der)$ ]]; then
        continue
    fi

    # Extract added lines (strip leading +), then normalize before matching:
    #   1. Remove envsubst placeholders (${VAR}) — template files are safe.
    #   2. Remove URLs — badge/shield URLs in Markdown are the canonical
    #      false-positive source for the high-entropy pattern.
    # Normalization is applied once here rather than per-pattern so the same
    # clean content is used consistently across all pattern checks.
    raw_lines="$(git diff --cached -- "$file" | grep -P '^\+[^+]' | sed 's/^\+//' || true)"
    [[ -z "$raw_lines" ]] && continue

    # Honour per-line opt-out annotations. Any line ending with
    # "# pre-commit: ignore" (leading/trailing whitespace allowed) is dropped
    # before pattern matching. Use this for intentional fake-secret test
    # fixtures and documentation examples — analogous to # noqa / # nolint.
    raw_lines="$(printf '%s\n' "$raw_lines" | grep -vP '#\s*pre-commit:\s*ignore\s*$' || true)"
    [[ -z "$raw_lines" ]] && continue

    normalized="$(printf '%s\n' "$raw_lines" \
        | sed 's/\${[A-Za-z_][A-Za-z0-9_]*}//g' \
        | sed 's|https\?://[^[:space:]"'"'"']*||g')"
    [[ -z "$normalized" ]] && continue

    for label in "${!PATTERNS[@]}"; do
        regex="${PATTERNS[$label]}"

        # For the high-entropy pattern only, restrict to lines with an assignment
        # context (contains = or : followed by content). This eliminates long
        # alphanumeric runs in comments, prose, and log output.
        if [[ "$label" == "Generic high-entropy string" ]]; then
            scan_lines="$(printf '%s\n' "$normalized" | grep -P '[:=]\s*["\x27]?[A-Za-z0-9+/]' || true)"
        else
            scan_lines="$normalized"
        fi
        [[ -z "$scan_lines" ]] && continue

        matches="$(printf '%s\n' "$scan_lines" | grep -oP "$regex" || true)"
        [[ -z "$matches" ]] && continue

        # Discard single-character-repeated strings (null SHA, placeholder runs).
        matches="$(printf '%s\n' "$matches" | grep -vP '^(.)\1*$' || true)"
        [[ -z "$matches" ]] && continue

        # Discard git SHAs used as version pins (COMMIT=, _commit:, git checkout…).
        sha_ctx="$(printf '%s\n' "$scan_lines" \
            | grep -P '(COMMIT[[:space:]]*[=:]|_commit[[:space:]]*:|git checkout|git rev-parse|_SHA[[:space:]]*[=:]|_HASH[[:space:]]*[=:])' \
            | grep -oP "$regex" | sort -u || true)"
        [[ -n "$sha_ctx" ]] && matches="$(printf '%s\n' "$matches" | grep -vFxf <(printf '%s\n' "$sha_ctx") || true)"
        [[ -z "$matches" ]] && continue

        # Discard GPG key fingerprints on signingkey lines (public info, not secrets).
        gpg_ctx="$(printf '%s\n' "$scan_lines" \
            | grep -P 'signingkey\s*=' \
            | grep -oP "$regex" | sort -u || true)"
        [[ -n "$gpg_ctx" ]] && matches="$(printf '%s\n' "$matches" | grep -vFxf <(printf '%s\n' "$gpg_ctx") || true)"
        [[ -z "$matches" ]] && continue

        # Discard bare exactly-40-char lowercase hex strings (git SHAs in YAML
        # block scalars, action pins, etc. with no surrounding key context).
        matches="$(printf '%s\n' "$matches" | grep -vP '^[0-9a-f]{40}$' || true)"
        [[ -z "$matches" ]] && continue

        # Discard filesystem paths. The high-entropy character class includes
        # alphanumerics and slash, so deep directory paths satisfy it even though
        # they carry no entropy. Anchored on real filesystem roots so base64
        # blobs (which don't start with /etc/) are still caught.
        path_ctx="$(printf '%s\n' "$scan_lines" \
            | grep -oP '(?<![A-Za-z0-9])/(?:etc|usr|var|home|opt|srv|tmp)/(?:[A-Za-z0-9._+-]+/)*[A-Za-z0-9._+-]+' \
            | grep -oP "$regex" | sort -u || true)"
        [[ -n "$path_ctx" ]] && matches="$(printf '%s\n' "$matches" | grep -vFxf <(printf '%s\n' "$path_ctx") || true)"
        [[ -z "$matches" ]] && continue

        echo -e "${RED}[pre-commit] Possible secret detected in $file${NC}"
        echo -e "  ${YELLOW}Pattern: $label${NC}"
        found=1
    done
done

if [[ "$found" -eq 1 ]]; then
    echo ""
    echo -e "${RED}Commit blocked: potential secrets found in staged files.${NC}"
    echo "If these are intentional (e.g. a git-crypt protected file),"
    echo "ensure the file is listed in .gitattributes, then commit again."
    echo "To bypass (use with care): git commit --no-verify"
    exit 1
fi
