# Ignore stow backup files
*.stow-local-ignore
*~

# Secrets — never commit these (git-crypt handles specific tracked secret files)
*.token
*.key
*secret*
!secrets/
!secrets/.secrets.env

# expand_templates() outputs — written to $HOME, never inside the repo tree
aws/.aws/credentials
aws/.aws/*.pmem
gh/.config/gh/hosts.yml


# Claude — session and runtime state (not config)
.claude/history.jsonl
.claude/mcp-needs-auth-cache.json
.claude/backups/
.claude/downloads/
.claude/file-history/
.claude/plans/
.claude/plugins/
.claude/projects/
.claude/session-env/
.claude/sessions/
.claude/shell-snapshots/
.claude/ide/
.claude/hooks/claude-notifier-active.d/
.claude/hooks/claude-notifier-task-start/
.claude/hooks/claude-notifier-focus
.claude/hooks/claude-notifier-muted
.claude/hooks/claude-signal
